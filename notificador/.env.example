# ♡ Variables PRIVADAS del notificador (configúralas en Vercel → Settings → Environment Variables).
# Este archivo es solo una guía: NO pongas aquí valores reales ni lo copies a un archivo que se suba a git.

# Sitios desde donde se puede llamar al notificador (separados por coma, sin "/" final).
# Ej.: https://tu-usuario.github.io,http://localhost:5173
ORIGENES_PERMITIDOS=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Tu número con código de país, solo dígitos (Perú = 51 + 9 dígitos). Ej.: 51XXXXXXXXX
WHATSAPP_DESTINO=
WHATSAPP_PLANTILLA=nueva_cartita
WHATSAPP_IDIOMA=es
GRAPH_API_VERSION=v23.0
# Solo para la primera prueba con la plantilla hello_world (WHATSAPP_PLANTILLA=hello_world, WHATSAPP_IDIOMA=en_US): false
WHATSAPP_CON_APODO=true

# Cloudflare Turnstile (protección anti-robots). La secret key es PRIVADA.
TURNSTILE_SECRET_KEY=
# Opcional: dominio desde el que debe venir el token. Ej.: tu-usuario.github.io
TURNSTILE_HOSTNAME=

# Solo para pruebas iniciales sin Turnstile. Déjalo vacío (o false) en producción.
PERMITIR_SIN_TURNSTILE=
