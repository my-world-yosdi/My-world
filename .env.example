# ♡ Variables PÚBLICAS de la página (Vite). Copia este archivo como `.env.local` para probar en local.
# Son públicas por diseño: terminan en el JavaScript del navegador. Tu correo y tu número NO van aquí.

# ID del formulario de Formspree (lo que va después de /f/ en https://formspree.io/f/xxxxxxxx)
VITE_FORMSPREE_FORM_ID=

# URL del notificador de WhatsApp en Vercel. Ej.: https://my-world-notificador.vercel.app/api/notificar
VITE_NOTIFICADOR_URL=

# Site key PÚBLICA de Cloudflare Turnstile (la secret key va solo en Vercel)
VITE_TURNSTILE_SITE_KEY=
